FROM hub.byted.org/reckon/data.reckon.mlx.image_20030:4151c389d5df796e4cf34c465e7870bb

USER root

# Record prerequisites of the unmodified v3 image. Never print environment secrets.
RUN echo PLATFORM_BEFORE && \
    (getent passwd tiger || true) && \
    (stat -c '%a %U:%G %n' /root /opt/tiger /opt/log/tiger /var/log/tiger /usr/local/bin || true) && \
    for tool in sudo sshd pip vim curl lsof wget systemctl getopt clear xargs nc ip; do \
      command -v "$tool" || true; \
    done

# Arnold bootstrap uses tiger. Preserve the compiled ML stack.
RUN apt-get -o Acquire::Retries=2 -o Acquire::http::Timeout=45 \
      -o Acquire::https::Timeout=45 update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      sudo openssh-server vim-tiny curl lsof wget systemd util-linux \
      ncurses-bin findutils netcat-openbsd iproute2 && \
    rm -rf /var/lib/apt/lists/*

RUN set -eu; \
    if ! getent group tiger >/dev/null; then \
      if getent group 1000 >/dev/null; then \
        old_group="$(getent group 1000 | cut -d: -f1)"; groupmod -n tiger "$old_group"; \
      else groupadd -g 1000 tiger; fi; \
    fi; \
    if ! id tiger >/dev/null 2>&1; then \
      if getent passwd 1000 >/dev/null; then \
        old_user="$(getent passwd 1000 | cut -d: -f1)"; \
        usermod -l tiger -d /home/tiger -m -g tiger -s /bin/bash "$old_user"; \
      else useradd -u 1000 -g tiger -m -d /home/tiger -s /bin/bash tiger; fi; \
    fi; \
    test "$(id -u tiger)" = 1000; \
    mkdir -p /etc/sudoers.d /opt/tiger /opt/log/tiger /var/log/tiger /run/sshd; \
    printf '%s\n' 'tiger ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/tiger; \
    chmod 0440 /etc/sudoers.d/tiger; \
    visudo -cf /etc/sudoers.d/tiger; \
    chown -R tiger:tiger /home/tiger /opt/tiger /opt/log/tiger /var/log/tiger; \
    chown tiger:tiger /usr/local/bin /usr/local/lib/python* /usr/lib/python*; \
    chmod o+x /root; \
    git config --system --add safe.directory /root/miles; \
    git config --system --add safe.directory /root/Megatron-LM; \
    git config --system --add safe.directory /sgl-workspace/sglang

# Editable installs retain original public source paths. No host permissions change.
RUN echo PLATFORM_AFTER && \
    runuser -u tiger -- /bin/bash -c \
      'set -eu; id; sudo -n true; test -w /opt/tiger; test -w /var/log/tiger; \
       test -r /root/miles/miles/__init__.py; \
       test "$(git -C /root/miles rev-parse HEAD)" = 2233d795dcf167be489d1859971c9233393f04c3; \
       python3 -c "import importlib.metadata as m; print({n:m.version(n) for n in (\"miles\",\"torch\",\"sglang\",\"ray\",\"transformer-engine\")})"; \
       for tool in sudo pip vim curl lsof wget systemctl getopt clear xargs nc ip; do command -v "$tool"; done'

WORKDIR /opt/tiger
LABEL lab.platform="arnold-tiger-prerequisites"
LABEL lab.validation="candidate-environment-not-gpu-validated"
